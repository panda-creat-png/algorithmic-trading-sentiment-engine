# QuantMind AI - Environment Configuration

# Application
PROJECT_NAME="QuantMind AI"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="quantmind-ai-super-secret-development-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Database
# For Docker / Local PostgreSQL: postgresql+asyncpg://quantuser:quantpass@localhost:5432/quantmind
# For zero-config fallback / headless testing: sqlite+aiosqlite:///./quantmind.db
DATABASE_URL="sqlite+aiosqlite:///./quantmind.db"
POSTGRES_USER="quantuser"
POSTGRES_PASSWORD="quantpass"
POSTGRES_DB="quantmind"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_HOST="localhost"
REDIS_PORT=6379

# Financial Data Providers (Optional / As Needed)
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
ALPACA_PAPER=true
NEWS_API_KEY=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="QuantMindAI/1.0"
TWITTER_BEARER_TOKEN=""

# AI Sentiment Model
FINBERT_MODEL_NAME="ProsusAI/finbert"
SENTIMENT_BATCH_SIZE=32
USE_GPU_IF_AVAILABLE=true

